bootloader --ptable msdos
part --source rawcopy --sourceparams="file=u-boot-rockchip.bin" --ondisk mmcblk0 --no-table --offset 32k
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 64
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs --align 4096 --size 256
